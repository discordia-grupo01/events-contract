{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/discordia-grupo01/events-contract/schemas/broadcast.server_reactivated.json",
  "title": "broadcast.server_reactivated",
  "description": "ServerReactivated is sent to every member when staff lifts the suspension.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "pattern": "^user:.+"
    },
    "event": {
      "type": "string",
      "enum": [
        "server_reactivated"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string"
        }
      },
      "required": [
        "server_id"
      ]
    }
  },
  "required": [
    "event_id",
    "topic",
    "event",
    "payload"
  ]
}
