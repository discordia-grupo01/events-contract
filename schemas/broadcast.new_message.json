{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/discordia-grupo01/events-contract/schemas/broadcast.new_message.json",
  "title": "broadcast.new_message",
  "description": "NewMessage is sent to every instance of messaging when a message is created, so each one pushes it to the sockets it holds.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "pattern": "^channel:.+"
    },
    "event": {
      "type": "string",
      "enum": [
        "new_message"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "channel_id": {
          "type": "string"
        },
        "server_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "inserted_at": {
          "type": "string",
          "format": "date-time"
        },
        "edited": {
          "type": "boolean"
        },
        "edited_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mention_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mention_everyone": {
          "type": "boolean"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "client_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "channel_id",
        "server_id",
        "user_id",
        "content",
        "inserted_at",
        "edited",
        "edited_at",
        "mentions",
        "mention_roles",
        "mention_everyone",
        "attachments"
      ]
    }
  },
  "required": [
    "event_id",
    "topic",
    "event",
    "payload"
  ]
}
