{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/discordia-grupo01/events-contract/schemas/broadcast.message_updated.json",
  "title": "broadcast.message_updated",
  "description": "MessageUpdated is published when the text of a message in a server channel is edited. It carries the mentions the message has after the edit, so a consumer can add the notification of whoever the edit mentioned and remove the one of whoever it stopped mentioning. OccurredAt is the moment of the edit. Direct messages never publish it: they have no mentions.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "pattern": "^channel:.+"
    },
    "event": {
      "type": "string",
      "enum": [
        "message_updated"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "channel_id": {
          "type": "string"
        },
        "server_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "inserted_at": {
          "type": "string",
          "format": "date-time"
        },
        "edited": {
          "type": "boolean"
        },
        "edited_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mention_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mention_everyone": {
          "type": "boolean"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "client_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "channel_id",
        "server_id",
        "user_id",
        "content",
        "inserted_at",
        "edited",
        "edited_at",
        "mentions",
        "mention_roles",
        "mention_everyone",
        "attachments"
      ]
    }
  },
  "required": [
    "event_id",
    "topic",
    "event",
    "payload"
  ]
}
