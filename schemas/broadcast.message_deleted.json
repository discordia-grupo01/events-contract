{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/discordia-grupo01/events-contract/schemas/broadcast.message_deleted.json",
  "title": "broadcast.message_deleted",
  "description": "MessageDeleted is sent when a message is deleted. It carries no content.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "pattern": "^channel:.+"
    },
    "event": {
      "type": "string",
      "enum": [
        "message_deleted"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "channel_id": {
          "type": "string"
        },
        "server_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "deleted_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "channel_id",
        "server_id",
        "deleted_at"
      ]
    }
  },
  "required": [
    "event_id",
    "topic",
    "event",
    "payload"
  ]
}
