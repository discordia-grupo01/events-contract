{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/discordia-grupo01/events-contract/schemas/platform.status_changed.json",
  "title": "platform.status_changed",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único del evento. Usar para deduplicar (at-least-once)."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento del hecho de negocio, ISO 8601 en UTC."
    },
    "status": {
      "type": "string",
      "enum": [
        "operational",
        "degraded",
        "maintenance"
      ]
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "status"
  ]
}
