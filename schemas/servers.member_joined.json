{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/discordia-grupo01/events-contract/schemas/servers.member_joined.json",
  "title": "servers.member_joined",
  "description": "MemberJoined is published when a user joins a server.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único del evento. Usar para deduplicar (at-least-once)."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento del hecho de negocio, ISO 8601 en UTC."
    },
    "server_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario (emitido por discordia-identify)."
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "server_id",
    "user_id"
  ]
}
