{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/discordia-grupo01/events-contract/schemas/admin.staff_member_removed.json",
  "title": "admin.staff_member_removed",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único del evento. Usar para deduplicar (at-least-once)."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento del hecho de negocio, ISO 8601 en UTC."
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "signature": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "user_id",
    "signature"
  ]
}
