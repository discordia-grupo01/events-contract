{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/discordia-grupo01/events-contract/schemas/servers.server_deleted.json",
  "title": "servers.server_deleted",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único del evento. Usar para deduplicar (at-least-once)."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento del hecho de negocio, ISO 8601 en UTC."
    },
    "server_id": {
      "type": "string",
      "format": "uuid"
    },
    "channel_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Ids de todos los canales (texto y voz) que tenía el servidor. Puede ser vacío, nunca null."
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "server_id",
    "channel_ids"
  ]
}
